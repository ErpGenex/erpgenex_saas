# Frappe-first public site — لا حاجة لـ Next على مسار /
# طبّق داخل server { ... } الخاص بالموقع، بدل:
#   location / { proxy_pass http://erpgenex-web; ... }
#
# الاستخدام:
#   استبدل كتلة location / في config/nginx.conf بهذه الكتلة ثم:
#   sudo nginx -t && sudo systemctl reload nginx
#   أو: bench setup nginx  ثم أعد تطبيق هذا المقتطف عبر السكربت.

	# ── ERPGenex Frappe-first public site (app-owned www/) ──
	# Sites + SaaS live in apps/*/www — installable without frontend/erpgenex-web
	location / {
		proxy_http_version 1.1;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Frappe-Site-Name erpgenex.local.site;
		proxy_set_header Host $host;
		proxy_set_header X-Use-X-Accel-Redirect True;
		proxy_read_timeout 120;
		proxy_redirect off;
		proxy_pass http://frappe-bench-frappe;
	}

	# اختياري: إن بقي Next للتجارب فقط
	# location /_next/ { proxy_pass http://erpgenex-web; ... }
